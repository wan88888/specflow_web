<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <TestResultsDir>$(MSBuildThisFileDirectory)../TestResults</TestResultsDir>
    <TestReportHtml>$(TestResultsDir)/report.html</TestReportHtml>
    <ReqnrollReportHtml>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/reqnroll-report.html</ReqnrollReportHtml>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.9.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="PuppeteerSharp" Version="25.3.1" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="reqnroll.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <Target Name="CopyReqnrollHtmlReport" AfterTargets="VSTest">
    <MakeDir Directories="$(TestResultsDir)" />
    <Copy
      SourceFiles="$(ReqnrollReportHtml)"
      DestinationFiles="$(TestReportHtml)"
      Condition="Exists('$(ReqnrollReportHtml)')" />
    <Message Importance="high" Text="HTML test report: $(TestReportHtml)" Condition="Exists('$(TestReportHtml)')" />
  </Target>

</Project>
